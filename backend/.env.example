# Application Configuration
PROJECT_NAME="PCOS360 API"
VERSION="1.0.0"
API_V1_STR="/api"
ENVIRONMENT="development"
DEBUG=true
DEBUG_SQL=false

# Server Host & Port
HOST="0.0.0.0"
PORT=8000

# Authentication & JWT Signing (Generate a unique >=32-char random value; never reuse in production)
# Example: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY="change-me-generate-a-long-random-secret-at-least-32-chars"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Auth Brute-Force Rate Limiting & Reverse Proxy Headers
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_IP_MAX_ATTEMPTS=20
AUTH_REGISTER_MAX_ATTEMPTS=10
TRUST_PROXY_HEADERS=false

# PostgreSQL Database Configuration
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/pcos360_db"

# CORS Configuration (JSON array of allowed origins)
BACKEND_CORS_ORIGINS='["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000", "http://localhost:8081"]'
