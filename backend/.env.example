# Application Configuration
PROJECT_NAME="PCOS360 API"
VERSION="1.0.0"
API_V1_STR="/api"
# Use "production" on Render / cloud, "development" on local machine
ENVIRONMENT="development"
DEBUG=true
DEBUG_SQL=false

# Server Host & Dynamic Port (Render injects PORT automatically)
HOST="0.0.0.0"
PORT=8000

# Authentication & JWT Signing (In production on Render, generateValue creates this automatically;
# for local dev, generate >=32 random chars: python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY="change-me-generate-a-long-random-secret-at-least-32-chars"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Auth Brute-Force Rate Limiting & Reverse Proxy Headers (Set to true in production on Render/Railway)
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_IP_MAX_ATTEMPTS=20
AUTH_REGISTER_MAX_ATTEMPTS=10
TRUST_PROXY_HEADERS=false

# Database Configuration (Supabase PostgreSQL):
# Format: postgresql+psycopg://<username>:<url_encoded_password>@<supabase-host>:5432/postgres?sslmode=require
DATABASE_URL="postgresql+psycopg://postgres.<project-ref>:<password>@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require"

# CORS Configuration (JSON array of allowed origins; set to '["*"]' in cloud for universal mobile access)
BACKEND_CORS_ORIGINS='["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000", "http://localhost:8081", "https://pcos360.onrender.com"]'
